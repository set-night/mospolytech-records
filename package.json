{
  "name": "mospolytech-records",
  "productName": "MosPolytech Records",
  "version": "0.1.0",
  "description": "Автоматическая запись вебинаров МТС Линк по расписанию Московского Политеха",
  "license": "MIT",
  "author": {
    "name": "set-night",
    "url": "https://github.com/set-night"
  },
  "homepage": "https://github.com/set-night/mospolytech-records",
  "repository": {
    "type": "git",
    "url": "https://github.com/set-night/mospolytech-records.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
